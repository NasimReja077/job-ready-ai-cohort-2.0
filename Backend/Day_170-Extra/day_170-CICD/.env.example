# Copy this file to .env and fill in real values (do NOT commit real secrets)

# MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<db_name>

# Redis connection details (host/port/password from your Redis provider)
REDIS_HOST=redis-xxxx.example.com
REDIS_PORT=12345
REDIS_PASSWORD=<redis-password>
# If your Redis provider requires TLS, set to true
REDIS_TLS=false

# App port (optional)
PORT=3000
