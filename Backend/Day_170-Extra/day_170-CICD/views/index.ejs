<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b0c10">
    <meta name="description" content="A personal portfolio for <%= username %>, a developer building thoughtful digital experiences.">
    <title><%= username %> — Developer Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <a class="wordmark" href="#home" aria-label="Go to home">
                <span class="wordmark-mark">N</span>
                <span>PORTFOLIO<span class="wordmark-period">.</span></span>
            </a>
            <nav class="main-nav" aria-label="Main navigation">
                <a class="nav-link" href="#about">About</a>
                <a class="nav-link" href="#users">Users</a>
                <a class="nav-link" href="#toolkit">Toolkit</a>
                <a class="nav-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
            </nav>
        </header>

        <main id="home">
            <section class="hero" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <p class="eyebrow"><span class="status-dot"></span> AVAILABLE FOR NEW OPPORTUNITIES</p>
                    <h1 id="hero-title">Turning ideas<br>into <span class="accent-text">digital</span><br>experiences<span class="accent-text">.</span></h1>
                    <p class="hero-description">Hey, I’m <strong><%= username %></strong> — a developer focused on building useful, thoughtful things for the web.</p>
                    <div class="hero-actions">
                        <a class="button button-primary" href="#about">Explore my work <span aria-hidden="true">↓</span></a>
                        <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
                    </div>
                    <div class="hero-meta">
                        <span class="meta-line"></span>
                        <span>DESIGN-MINDED DEVELOPER</span>
                        <span class="meta-separator">/</span>
                        <span>BUILDING FOR THE WEB</span>
                    </div>
                </div>

                <div class="hero-visual" aria-label="Profile photo of <%= username %>">
                    <div class="visual-orbit orbit-one"></div>
                    <div class="visual-orbit orbit-two"></div>
                    <div class="portrait-frame">
                        <img src="<%= profilePicture %>" alt="Portrait of <%= username %>" class="portrait">
                        <div class="portrait-shade"></div>
                        <div class="portrait-label">
                            <span class="label-index">01 / PROFILE</span>
                            <span class="label-name"><%= username %></span>
                        </div>
                    </div>
                    <div class="floating-note">
                        <span class="note-icon" aria-hidden="true">✳</span>
                        <span>Curious by nature.<br><strong>Builder by choice.</strong></span>
                    </div>
                    <span class="visual-coordinate">20° 35' 14.0" N</span>
                </div>
                <a class="scroll-cue" href="#about"><span class="scroll-line"></span> SCROLL TO EXPLORE</a>
            </section>

            <section class="about-section section-grid" id="about" aria-labelledby="about-title">
                <div class="section-kicker"><span>01</span> A LITTLE ABOUT ME</div>
                <div class="about-content">
                    <h2 id="about-title">Good work starts<br>with <span class="muted-text">curiosity.</span></h2>
                    <p class="about-description"><%= bio %></p>
                    <div class="about-bottom">
                        <span class="availability"><span class="status-dot"></span> OPEN TO COLLABORATION</span>
                        <span class="signature">Let’s make something matter.</span>
                    </div>
                </div>
            </section>

            <section class="users-section section-grid" id="users" aria-labelledby="users-title">
                <div class="section-kicker"><span>02</span> OUR COMMUNITY</div>
                <div class="users-content">
                    <div class="users-heading">
                        <div>
                            <h2 id="users-title">Meet the <span class="muted-text">people.</span></h2>
                            <p>Some of the people who are part of this community.</p>
                        </div>
                        <span class="users-count"><%= users.length.toString().padStart(2, "0") %> / 03</span>
                    </div>
                    <% if (userCreated) { %>
                        <p class="form-message form-message-success" role="status">User created successfully.</p>
                    <% } %>
                    <% if (formError) { %>
                        <p class="form-message form-message-error" role="alert"><%= formError %></p>
                    <% } %>
                    <form class="user-form" action="/user" method="post">
                        <div class="form-field">
                            <label for="user-name">Name</label>
                            <input id="user-name" name="name" type="text" autocomplete="name" maxlength="100" value="<%= formValues.name || '' %>" placeholder="Jane Doe" required>
                        </div>
                        <div class="form-field">
                            <label for="user-email">Email</label>
                            <input id="user-email" name="email" type="email" autocomplete="email" maxlength="254" value="<%= formValues.email || '' %>" placeholder="jane@example.com" required>
                        </div>
                        <button class="button button-primary user-submit" type="submit">Create user <span aria-hidden="true">↗</span></button>
                    </form>
                    <% if (users.length > 0) { %>
                        <div class="user-grid">
                            <% users.forEach((user, index) => { %>
                                <article class="user-card">
                                    <div class="user-card-top">
                                        <span class="user-avatar" aria-hidden="true"><%= user.name ? user.name.charAt(0).toUpperCase() : "U" %></span>
                                        <span class="user-index">MEMBER / <%= String(index + 1).padStart(2, "0") %></span>
                                    </div>
                                    <h3><%= user.name || "Unnamed user" %></h3>
                                    <p><%= user.email || "No email provided" %></p>
                                </article>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="users-empty">No users yet. Add users to the database and they’ll appear here.</p>
                    <% } %>
                </div>
            </section>

            <section class="toolkit-section section-grid" id="toolkit" aria-labelledby="toolkit-title">
                <div class="section-kicker"><span>03</span> HOW I BUILD</div>
                <div class="toolkit-content">
                    <div class="toolkit-heading">
                        <h2 id="toolkit-title">A thoughtful<br><span class="muted-text">toolkit.</span></h2>
                        <p>Tools are just the start. I care about the details that make the whole experience feel right.</p>
                    </div>
                    <div class="tool-list" aria-label="Development principles">
                        <div class="tool-item"><span class="tool-number">01</span><span>Frontend development</span><span class="tool-arrow" aria-hidden="true">↗</span></div>
                        <div class="tool-item"><span class="tool-number">02</span><span>Backend &amp; APIs</span><span class="tool-arrow" aria-hidden="true">↗</span></div>
                        <div class="tool-item"><span class="tool-number">03</span><span>Responsive experiences</span><span class="tool-arrow" aria-hidden="true">↗</span></div>
                        <div class="tool-item"><span class="tool-number">04</span><span>Continuous learning</span><span class="tool-arrow" aria-hidden="true">↗</span></div>
                    </div>
                </div>
            </section>

            <section class="contact-section" id="contact" aria-labelledby="contact-title">
                <span class="contact-orb" aria-hidden="true"></span>
                <p class="eyebrow">HAVE A GOOD ONE IN MIND?</p>
                <h2 id="contact-title">Let’s build<br>what’s <span class="accent-text">next.</span></h2>
                <p class="contact-copy">Have a project, an idea, or just want to say hello?</p>
                <a class="button button-light" href="#about">Get to know me <span aria-hidden="true">↑</span></a>
            </section>
        </main>

        <footer class="site-footer">
            <a class="wordmark footer-wordmark" href="#home"><span class="wordmark-mark">N</span><span>PORTFOLIO<span class="wordmark-period">.</span></span></a>
            <span>DESIGNED TO KEEP MOVING <span class="accent-text">©</span> <%= new Date().getFullYear() %></span>
            <a class="back-to-top" href="#home">BACK TO TOP ↑</a>
        </footer>
    </div>
</body>
</html>
